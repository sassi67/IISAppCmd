<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net481</TargetFramework>
    <RootNamespace>IISAppCmd</RootNamespace>
    <AssemblyName>IISAppCmd</AssemblyName>
    <Nullable>disable</Nullable>
    <Deterministic>true</Deterministic>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <!-- Properties\AssemblyInfo.cs carries the assembly attributes. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- Keep the documented bin\Debug\IISAppCmd.exe location. -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- The test project lives under test\ and must not be compiled into the exe. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);test\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.Administration" Version="11.1.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- JavaScriptSerializer, which reads the JSON value of the application option. -->
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Resources\applicationHost.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="Resources\IISAgentConfigSchema.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
